{
  "_comment_top": "Claude Code settings template. Copy to .claude/settings.json in any project adopting the harness. Replace {{REPO_ROOT}} with the absolute path to the project root before use. Comments use _comment_* keys because JSON does not support inline comments.",
  "_comment_permissions": "Permission mode defaults to default for write phases. Override to plan for discovery-only sessions. Per AP.1, hooks below provide deterministic enforcement; permission mode is the model-visible scope.",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Bash(./scripts/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(jq:*)",
      "Bash(shellcheck:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(pre-commit run:*)",
      "Bash(semgrep:*)",
      "Bash(gitleaks:*)",
      "Read(//tmp/**)",
      "Edit(//tmp/**)",
      "Read(//private/tmp/**)",
      "Edit(//private/tmp/**)",
      "Read(//var/folders/*/*/T/**)",
      "Edit(//var/folders/*/*/T/**)",
      "Read(//private/var/folders/*/*/T/**)",
      "Edit(//private/var/folders/*/*/T/**)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Read(//etc/shadow)",
      "Read(//etc/passwd)",
      "Read(~/.config/gh/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Bash(curl *| sh)",
      "Bash(curl *| bash)",
      "Bash(wget *| sh)",
      "Bash(wget *| bash)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~/:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME/)",
      "Bash(rm -rf ${HOME}:*)",
      "Bash(rm -rf ${HOME}/)",
      "Bash(rm -rf /Users:*)",
      "Bash(rm -rf /Users/:*)",
      "Bash(rm -rf /home:*)",
      "Bash(rm -rf /home/:*)",
      "Bash(sudo *)",
      "Edit(//etc/**)",
      "Edit(//private/etc/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.aws/credentials)",
      "Edit(~/.aws/config)",
      "Edit(~/.kube/config)"
    ]
  },
  "_comment_hooks": "Hooks register against Claude Code events. PostToolUse on Write and Edit fires the commit-time Semgrep hook (the SecureForge Appendix C pattern, R.2.1). The five destructive-class hooks (external-write-gate, cached-prefix-write-gate, git-push-force-ask, bash-deny-rm-protected-paths, ConfigChange-audit-claude-config) fail closed per AP.8: onFailure: block, exec form under python3 -I, 10 second timeout. The other hooks fail open by design, so a stalled advisory hook cannot wedge a run. Registrations mirror mac/harness/settings.json (the Mac reference build) with {{REPO_ROOT}} paths.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{REPO_ROOT}}/harness/hooks/post-tool-use-semgrep.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{REPO_ROOT}}/harness/hooks/pre-tool-use-shell-audit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{REPO_ROOT}}/harness/hooks/PreToolUse-bash-cap-subcommands.py"
          },
          {
            "type": "command",
            "command": "{{REPO_ROOT}}/harness/hooks/PreToolUse-supply-chain-bash-checks.py"
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "{{REPO_ROOT}}/harness/hooks/PreToolUse-git-push-force-ask.py"
            ],
            "onFailure": "block",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "{{REPO_ROOT}}/harness/hooks/PreToolUse-bash-deny-rm-protected-paths.py"
            ],
            "onFailure": "block",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "{{REPO_ROOT}}/harness/hooks/PreToolUse-external-write-gate.py"
            ],
            "onFailure": "block",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "{{REPO_ROOT}}/harness/hooks/PreToolUse-cached-prefix-write-gate.py"
            ],
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{REPO_ROOT}}/harness/hooks/session-start.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "{{REPO_ROOT}}/harness/hooks/SessionStart-audit-claude-config.py"
          },
          {
            "type": "command",
            "command": "{{REPO_ROOT}}/harness/hooks/SessionStart-audit-plugin-updates.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{REPO_ROOT}}/harness/hooks/pre-compact-preserve.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{REPO_ROOT}}/harness/hooks/Stop-prune-session-logs.py"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "project_settings|local_settings",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "{{REPO_ROOT}}/harness/hooks/ConfigChange-audit-claude-config.py"
            ],
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "_comment_mcp": "MCP servers are intentionally not listed here. Per AP.7 (lazy load), servers load on demand through tool search rather than at session start.",
  "mcpServers": {},
  "_comment_env": "Telemetry controls. Note: setting telemetry off kills the 1h cache TTL silently per QC.4a. Keep telemetry on unless you have an explicit reason and accept the cache cost.",
  "env": {
    "DISABLE_TELEMETRY": "0",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "0"
  },
  "_comment_status_line": "Status line surfaces drift-check result and hook log size for visibility. Update path if your harness install location differs.",
  "statusLine": {
    "type": "command",
    "command": "{{REPO_ROOT}}/harness/hooks/status-line.sh"
  },
  "_comment_version_pin": "Record the Claude Code minor-version range this harness is validated against. Bump triggers QC.5 re-evaluation.",
  "_validated_claude_code_range": ">=2.1.295,<2.2 (2.1.295: onFailure block on command hooks; 2.1.268: deny rules apply at a symlink's real location; 2.1.228: a Read deny also covers the Write tool)"
}
